# Local development only. Do not commit a real .env file.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-unique-random-value-at-least-32-characters
CORS_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=farm_manager
DB_USER=fms_app
# When using Docker Compose, this must exactly match FMS_MYSQL_PASSWORD below.
DB_PASSWORD=replace-with-a-local-development-password

# Required only for the isolated local Docker MySQL container.
# These values never leave this computer and are ignored by Git.
FMS_MYSQL_PASSWORD=replace-with-a-local-development-password
FMS_MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
FMS_SESSION_SECRET=replace-with-a-unique-random-value-at-least-32-characters

# Required only when deliberately seeding a development database. Each must be 12+ characters.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_ACCOUNTANT_PASSWORD=
SEED_WORKER_PASSWORD=
